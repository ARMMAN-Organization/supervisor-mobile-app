<resources>
  <!-- AppCompat parent required for per-app locales (Choose Language) below API 33. -->
  <style name="Theme.ArogyaSupervisor" parent="Theme.AppCompat.DayNight.NoActionBar">
    <!-- Matches Compose's MaterialTheme.colorScheme.background (BackgroundLavender) so the
         window's first painted frame doesn't flash the AppCompat default white during
         Activity/navigation transitions. -->
    <item name="android:windowBackground">@color/background_lavender</item>
  </style>
</resources>
